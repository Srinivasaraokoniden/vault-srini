            "id": "srinivas-kv-policy",
            "name": "srinivas-kv-policy",
            "namespace": null,
            "policy": "# Allow the tenant to create, update and read secrets\r\npath \"kv/data/srinivas\" {\r\n  capabilities = [\"create\", \"update\", \"read\"]\r\n}\r\n\r\npath \"kv/data/srinivas/*\" {\r\n  capabilities = [\"create\", \"update\", \"read\"]\r\n}\r\n\r\n# Allow listing and reading metadata\r\npath \"kv/metadata/srinivas\" {\r\n  capabilities = [\"read\", \"list\"]\r\n}\r\n\r\npath \"kv/metadata/srinivas/*\" {\r\n  capabilities = [\"read\", \"list\"]\r\n}\r\n"
